{
  "name": "liti",
  "version": "0.1.0",
  "private": true,
  "description": "砺题 Liti —— 面向局域网的学习刷题系统",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web",
    "electron"
  ],
  "scripts": {
    "dev:server": "pnpm --filter @liti/server dev",
    "dev:web": "pnpm --filter @liti/web dev",
    "build": "pnpm --filter @liti/web build",
    "start": "pnpm --filter @liti/server start",
    "migrate": "pnpm --filter @liti/server migrate",
    "seed": "pnpm --filter @liti/server seed",
    "test": "pnpm --filter @liti/server test",
    "test:unit": "pnpm --filter @liti/server test:unit",
    "test:integration": "pnpm --filter @liti/server test:integration",
    "test:e2e": "playwright test",
    "electron:build": "pnpm --filter @liti/electron build",
    "electron:start": "pnpm --filter @liti/electron start"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}
