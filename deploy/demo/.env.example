# 复制成 .env 再填值：cp .env.example .env

# 会话签名密钥。至少 16 个字符，建议直接生成：
#   openssl rand -hex 32
# 演示站被人猜到也无所谓，但别用空值 —— 空值容器起不来。
SESSION_SECRET=

# 对外端口
DEMO_PORT=8089

# 监听地址。
#   127.0.0.1  → 只给本机的 nginx 用（推荐，配合 HTTPS）
#   0.0.0.0    → 直接对外，记得把 TRUST_PROXY 改成 0
DEMO_BIND=127.0.0.1

# 是否信任 X-Forwarded-For。
# 挂在 nginx 后面填 1，这样审计日志记的是访客真实 IP，限流也按真实 IP 分桶。
# 直接对外暴露端口时必须填 0。
TRUST_PROXY=1
