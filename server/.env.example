# 服务
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# 数据库：sqlite | mysql
DB_DRIVER=sqlite
SQLITE_PATH=data/app.db
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/liti

# 会话（生产环境务必改为长随机字符串）
SESSION_SECRET=please-change-me-to-a-long-random-string
# 会话有效期（毫秒），默认 7 天
SESSION_TTL_MS=604800000

# 认证方式：local | local,oidc | oidc
AUTH_PROVIDERS=local
